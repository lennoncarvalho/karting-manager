# Kartarados v2 environment variables
#
# Angular CLI does not auto-load .env files. Either:
#   (a) Copy this file to .env.local and update src/environments/environment.ts
#       manually (it has a `// === read from .env if you wire dotenv ===` block).
#   (b) Edit src/environments/environment.ts / environment.prod.ts directly.
#
# DO NOT commit a populated .env or environment file with real keys.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — OCR primary provider (falls back to Tesseract.js `por` if missing)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Optional — Sentry error monitoring
SENTRY_DSN=

# Public app URL (used for password reset / email-confirm redirects)
APP_URL=http://localhost:4200
