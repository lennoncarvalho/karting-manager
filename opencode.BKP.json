   },
   "instructions": [
     "AGENTS.md"
   ],
   "commands": {
     "dev": {
       "description": "Start Vite dev server",
       "template": "cd react && npm run dev -- --host"
     },
     "build": {
       "description": "Build React app for production",
       "template": "cd react && npm run build"
     },
     "preview": {
       "description": "Preview built React app",
       "template": "cd react && npm run preview"
     }
   },
   "compaction": {
     "auto": true,
     "preserve_recent_tokens": 30000,
     "tail_turns": 5
