{
   "$schema": "https://opencode.ai/config.json",
   "lsp": {},
   "formatter": {
     "prettier": {
       "command": ["prettier", "--stdin-filepath", "$FILE"]
     }
   },
   "instructions": [
     "AGENTS.md"
   ],
   "commands": {
     "dev": {
       "description": "Start Vite dev server in react/",
       "template": "cd react && npm run dev -- --host"
     },
     "build": {
       "description": "Build React app for production",
       "template": "cd react && npm run build"
     },
     "preview": {
       "description": "Preview built React app",
       "template": "cd react && npm run preview"
     }
   },
   "compaction": {
     "auto": true,
     "preserve_recent_tokens": 30000,
     "tail_turns": 5
   },
   "agent": {
     "build": {
       "model": "ollama/qwen3.6:35b-a3b-coding-mxfp8",
       "top_p": 0.9
     }
   },
   "permission": {
     "bash": {
       "npm *": "allow",
       "cd react *": "allow",
       "git *": "allow",
       "*": "ask"
     }
   }
}
